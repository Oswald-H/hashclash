@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)
find_dependency(ZLIB)
find_dependency(BZip2)
find_dependency(cereal CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/HashClashTargets.cmake")

set(HashClash_CLI11_FOUND FALSE)
set(_hashclash_requested_components "${HashClash_FIND_COMPONENTS}")
list(FIND _hashclash_requested_components "CLI11" _hashclash_cli11_component_index)
if(NOT _hashclash_cli11_component_index EQUAL -1)
  if(HashClash_FIND_REQUIRED_CLI11)
    find_dependency(CLI11 CONFIG)
  else()
    find_package(CLI11 CONFIG QUIET)
  endif()
  if(CLI11_FOUND)
    include("${CMAKE_CURRENT_LIST_DIR}/HashClashCLITargets.cmake")
    set(HashClash_CLI11_FOUND TRUE)
  endif()
endif()

check_required_components(HashClash)
